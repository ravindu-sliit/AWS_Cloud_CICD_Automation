# =============================================================================
# .dockerignore
# =============================================================================
# Like .gitignore, but for Docker.
# Files listed here are NOT copied into the image.
# This makes builds faster and images smaller.
# =============================================================================

# Python virtual environment - container has its own
venv/
.venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Git
.git/
.gitignore

# IDE settings
.vscode/
.idea/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation (optional - include if you need them in container)
*.md
docs/

# Environment files (NEVER include these - security risk!)
.env
.env.*
*.env

# Local development
docker-compose*.yml
Dockerfile*

# OS files
.DS_Store
Thumbs.db

# Terraform (we'll add this later)
terraform/
*.tfstate
*.tfstate.*
.terraform/
